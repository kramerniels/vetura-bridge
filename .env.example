# Copy to .env and fill in values. Never commit .env to git.

# Cloud API (register + bootstrap poll)
# Production: real online app. Local pairing: tools/pairing-mock (default port 3457)
CLOUD_API_URL=https://api.example.com
# CLOUD_API_URL=http://192.168.1.10:3457

# Cloud frontend (QR / pair URL)
CLOUD_FRONTEND_URL=https://app.example.com
# CLOUD_FRONTEND_URL=http://192.168.1.10:3457

# Scaleway NATS — filled by QR bootstrap or manual setup
NATS_URL=tls://nats.mnq.nl-ams.scaleway.com:4222
NATS_STREAM=commands
# Per-device defaults after pairing (composed on the Pi from deviceId):
# NATS_SUBJECT=commands.<deviceId>.>
# NATS_ERROR_SUBJECT=errors.<deviceId>
# NATS_RESULT_SUBJECT=results.<deviceId>
# NATS_CONSUMER=pi-<deviceId>
NATS_SUBJECT=commands.>
NATS_ERROR_SUBJECT=errors
NATS_RESULT_SUBJECT=results
NATS_CONSUMER=pi-printer-1
NATS_MAX_AGE_SEC=900
