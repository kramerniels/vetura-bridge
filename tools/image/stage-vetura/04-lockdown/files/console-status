#!/bin/sh
# HDMI: keep splash until the portal answers, then always start the kiosk.
# Do not abort on failed systemd units — that prevented the kiosk after reboot.
set -eu
export HOME="${HOME:-/var/lib/vetura-hdmi}"
export DISPLAY="${DISPLAY:-:0}"
cd "${HOME}"

ply_ping() {
	sudo -n /usr/lib/vetura/hdmi-plymouth-ctl ping >/dev/null 2>&1
}

ply_release() {
	sudo -n /usr/lib/vetura/hdmi-plymouth-ctl release >/dev/null 2>&1 || true
}

portal_ready() {
	[ -f /boot/firmware/vetura-provision.done ] || return 1
	curl -sf -o /dev/null --max-time 2 http://127.0.0.1/
}

splash=""
if ! ply_ping; then
	/usr/bin/python3 -u /usr/lib/vetura/hdmi-splash.py &
	splash=$!
fi

while ! portal_ready; do
	sleep 1
done

if [ -n "${splash}" ]; then
	kill "${splash}" 2>/dev/null || true
	wait "${splash}" 2>/dev/null || true
fi

ply_release
sleep 1
exec /usr/lib/vetura/kiosk
