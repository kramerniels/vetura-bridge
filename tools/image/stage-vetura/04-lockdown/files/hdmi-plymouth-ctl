#!/bin/sh
# Root-only helper: vetura-hdmi may call ping|quit|reveal|release via sudoers.
set -eu
cmd="${1:-}"
case "${cmd}" in
	ping)
		exec /usr/bin/plymouth --ping
		;;
	quit)
		exec /usr/bin/plymouth quit
		;;
	release)
		/usr/bin/plymouth quit 2>/dev/null || true
		rm -f /tmp/.X0-lock /tmp/.X1-lock /tmp/.X11-unix/X0
		rm -f /var/lib/vetura-hdmi/.config/vetura-kiosk/SingletonLock \
			/var/lib/vetura-hdmi/.config/vetura-kiosk/SingletonSocket \
			/var/lib/vetura-hdmi/.config/vetura-kiosk/SingletonCookie
		exit 0
		;;
	reveal)
		/usr/bin/plymouth quit 2>/dev/null || true
		{
			printf '\nVetura: boot had failed units:\n'
			systemctl --failed --no-pager --full --plain --no-legend || true
			printf '\n'
		} >/dev/console 2>/dev/null || true
		exit 0
		;;
	*)
		echo "usage: $0 ping|quit|reveal|release" >&2
		exit 2
		;;
esac
