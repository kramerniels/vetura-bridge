# Logo only: Image.Text needs pango/fonts in initramfs and aborts the
# theme if they are missing (then HDMI shows raw systemd).
Window.SetBackgroundTopColor(1.0, 1.0, 1.0);
Window.SetBackgroundBottomColor(1.0, 1.0, 1.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

logo.image = Image("logo.png");
ow = logo.image.GetWidth();
oh = logo.image.GetHeight();
max_w = screen_w * 72 / 100;
max_h = screen_h * 34 / 100;
nw = max_w;
nh = oh * nw / ow;
if (nh > max_h) {
    nh = max_h;
    nw = ow * nh / oh;
}
if (nw < 1) { nw = 1; }
if (nh < 1) { nh = 1; }
logo.image = logo.image.Scale(nw, nh);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_x + (screen_w - logo.image.GetWidth()) / 2);
logo.sprite.SetY(screen_y + screen_h * 28 / 100);

# Smooth in/out (~4s period). Avoid a 1.0/0.62 step, which looks like blinking.
progress = 0;
fun refresh_callback() {
    progress = progress + 1;
    t = progress % 80;
    if (t > 40) {
        t = 80 - t;
    }
    n = t / 40;
    smooth = n * n * (3 - 2 * n);
    logo.sprite.SetOpacity(0.22 + smooth * 0.78);
}

Plymouth.SetRefreshFunction(refresh_callback);
