Window.SetBackgroundTopColor(1.0, 1.0, 1.0);
Window.SetBackgroundBottomColor(1.0, 1.0, 1.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

logo.image = Image("logo.png");
ow = logo.image.GetWidth();
oh = logo.image.GetHeight();
max_w = screen_w * 72 / 100;
max_h = screen_h * 34 / 100;
nw = max_w;
nh = oh * nw / ow;
if (nh > max_h) {
    nh = max_h;
    nw = ow * nh / oh;
}
if (nw < 1) { nw = 1; }
if (nh < 1) { nh = 1; }
logo.image = logo.image.Scale(nw, nh);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_x + (screen_w - logo.image.GetWidth()) / 2);
logo.sprite.SetY(screen_y + screen_h * 28 / 100);

# Gentle breath (~5s period). Stay near full opacity so the logo never vanishes.
progress = 0;
fun refresh_callback() {
    progress = progress + 1;
    t = progress % 100;
    if (t > 50) {
        t = 100 - t;
    }
    n = t / 50;
    smooth = n * n * (3 - 2 * n);
    logo.sprite.SetOpacity(0.82 + smooth * 0.18);
}

Plymouth.SetRefreshFunction(refresh_callback);

# Progress bar under the logo, driven by `plymouth system-update --progress=N`
# (the first-boot LUKS encrypt). Built from scaled 1x1 images so it needs no
# text plugin. Hidden until the first update.
bar_w = logo.image.GetWidth();
if (bar_w < screen_w * 40 / 100) { bar_w = screen_w * 40 / 100; }
bar_h = screen_h / 60;
if (bar_h < 4) { bar_h = 4; }
bar_x = screen_x + (screen_w - bar_w) / 2;
bar_y = screen_y + screen_h * 28 / 100 + logo.image.GetHeight() + screen_h * 8 / 100;

bar.bg = Sprite(Image("bar-bg.png").Scale(bar_w, bar_h));
bar.bg.SetPosition(bar_x, bar_y, 1);
bar.bg.SetOpacity(0);
bar.fg_image = Image("bar-fg.png");
bar.fg = Sprite(bar.fg_image.Scale(1, bar_h));
bar.fg.SetPosition(bar_x, bar_y, 2);
bar.fg.SetOpacity(0);

fun system_update_callback(pct) {
    if (pct < 0) { pct = 0; }
    if (pct > 100) { pct = 100; }
    w = bar_w * pct / 100;
    if (w < 1) { w = 1; }
    bar.fg.SetImage(bar.fg_image.Scale(w, bar_h));
    bar.bg.SetOpacity(1);
    bar.fg.SetOpacity(1);
}

Plymouth.SetSystemUpdateFunction(system_update_callback);

# Status line under the bar, from `plymouth display-message --text=...`.
# Image.Text needs the label plugin (plymouth-label) in the initramfs.
message.sprite = Sprite();
message.sprite.SetPosition(bar_x, bar_y + bar_h + screen_h * 2 / 100, 3);

fun display_message_callback(text) {
    image = Image.Text(text, 0.2, 0.2, 0.2, 1, "Sans " + Math.Int(screen_h / 40));
    message.sprite.SetImage(image);
    message.sprite.SetX(screen_x + (screen_w - image.GetWidth()) / 2);
    message.sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
    message.sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
