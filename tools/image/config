# pi-gen config for the DKGM Pi golden image (Raspberry Pi OS Lite 64-bit).
# Override secrets and CLOUD_BASE_URL in config.local (see config.local.example).

IMG_NAME='dkgm-pi'
PI_GEN_RELEASE='DKGM Pi'
RELEASE='trixie'

TARGET_HOSTNAME='dkgm'
LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT='Europe/Amsterdam'

ENABLE_SSH=1
# SSH is pubkey-only. Set PUBKEY_SSH_FIRST_USER and PUBKEY_ONLY_SSH=1 in config.local.
# FIRST_USER_PASS is required by pi-gen but is not used for login (build.sh randomises it).
FIRST_USER_NAME='dkgm'
DISABLE_FIRST_BOOT_USER_RENAME=1
PASSWORDLESS_SUDO=1

# WLAN country (unblocks wifi). SSID/password via Raspberry Pi Imager or later config.
WPA_COUNTRY='NL'

DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL=6

# Online app base URL baked into /opt/dkgm-agent/.env (override in config.local)
export CLOUD_BASE_URL='https://app.example.com'

# Lite base (stage0–2) + DKGM stage; desktop stages skipped by build.sh
STAGE_LIST='stage0 stage1 stage2 stage-dkgm'
