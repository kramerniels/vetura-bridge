#!/bin/sh
# First-boot provisioner: OTP key + request LUKS encrypt, then signed boot.
# Runs before dkgm-agent. Reboots as needed; pairing starts after this completes.
set -eu

STATE_DONE=/boot/firmware/dkgm-provision.done
NEXT=/boot/firmware/dkgm-provision-next
PENDING=/boot/firmware/dkgm-encrypt-pending
SB_DIR=/usr/lib/dkgm/secure-boot
KEYSCRIPT=/usr/lib/dkgm/luks-key
LOG=/var/log/dkgm-provision.log

log() {
	printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "${LOG}"
}

is_pi5() {
	[ -f /proc/device-tree/model ] || return 1
	tr -d '\0' </proc/device-tree/model | grep -q 'Raspberry Pi 5'
}

root_is_luks() {
	src=$(findmnt -n -o SOURCE /)
	case "${src}" in
		/dev/mapper/*) return 0 ;;
	esac
	type=$(blkid -o value -s TYPE "${src}" 2>/dev/null || true)
	[ "${type}" = "crypto_LUKS" ]
}

ensure_otp_key() {
	if rpi-fw-crypto pubkey --key-id 1 >/dev/null 2>&1; then
		return 0
	fi
	log "Provisioning OTP key id 1 (one-time, irreversible)"
	if rpi-fw-crypto genkey --key-id 1 --alg ec; then
		return 0
	fi
	rpi-fw-crypto genkey --key-id 1
}

apply_signed_boot() {
	if [ ! -f "${SB_DIR}/boot.img" ] || [ ! -f "${SB_DIR}/boot.sig" ]; then
		log "No signed boot.img in ${SB_DIR}; skipping EEPROM/OTP lock"
		return 1
	fi
	mkdir -p /boot/firmware
	cp -f "${SB_DIR}/boot.img" /boot/firmware/boot.img
	cp -f "${SB_DIR}/boot.sig" /boot/firmware/boot.sig
	if [ -f "${SB_DIR}/pieeprom.bin" ]; then
		log "Scheduling signed EEPROM update"
		rpi-eeprom-update -d -f "${SB_DIR}/pieeprom.bin" || \
			log "rpi-eeprom-update failed; boot.img is in place"
	fi
	return 0
}

if [ -f "${STATE_DONE}" ]; then
	exit 0
fi

mkdir -p /boot/firmware
touch "${LOG}"

if ! is_pi5; then
	log "ERROR: this image is Raspberry Pi 5 only"
	exit 1
fi

if [ ! -f "${NEXT}" ]; then
	printf '%s\n' "encrypt" >"${NEXT}"
fi

phase=$(tr -d ' \n' <"${NEXT}")

case "${phase}" in
	encrypt)
		if root_is_luks; then
			log "Root already LUKS; skipping encrypt"
			printf '%s\n' "secure-boot" >"${NEXT}"
			phase=secure-boot
		else
			ensure_otp_key
			if ! "${KEYSCRIPT}" >/dev/null; then
				log "ERROR: cannot derive LUKS passphrase (OTP/HMAC)"
				exit 1
			fi
			log "Requesting initramfs LUKS encrypt; rebooting"
			touch "${PENDING}"
			sync
			/bin/systemctl reboot
			exit 0
		fi
		;;
esac

case "${phase}" in
	secure-boot)
		if apply_signed_boot; then
			printf '%s\n' "reboot-sb" >"${NEXT}"
			sync
			log "Signed boot artifacts installed; rebooting"
			/bin/systemctl reboot
			exit 0
		fi
		log "Signed boot skipped or incomplete; finishing provision"
		touch "${STATE_DONE}"
		rm -f "${NEXT}" "${PENDING}"
		exit 0
		;;
	reboot-sb)
		log "Provision complete (LUKS + signed boot)"
		touch "${STATE_DONE}"
		rm -f "${NEXT}" "${PENDING}"
		exit 0
		;;
	*)
		log "Unknown provision phase: ${phase}"
		exit 1
		;;
esac
