#!/bin/sh
# HDMI has no getty; print where to reach the appliance after boot.
ip=""
i=0
while [ "${i}" -lt 12 ]; do
	ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
	[ -n "${ip}" ] && break
	i=$((i + 1))
	sleep 2
done
if [ -z "${ip}" ]; then
	ip="(no IPv4 — plug Ethernet)"
fi
{
	printf '\n'
	printf 'DKGM ready (no local login on HDMI).\n'
	printf 'Portal: http://%s/\n' "${ip}"
	printf 'SSH:    dkgm@%s\n' "${ip}"
	printf '\n'
} >/dev/console 2>/dev/null || true
