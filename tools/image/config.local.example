# Copy to config.local and fill in. config.local is gitignored.

# staging (default) or production. Part of the image name, and SECURE_BOOT_KEY
# must match keys/<IMAGE_ENV>.pub.pem. Override without editing:
#   IMAGE_ENV=production ./build.sh
IMAGE_ENV=staging

# Baked into /opt/vetura-agent/.env according to IMAGE_ENV.
STAGING_CLOUD_API_URL='https://api-staging.vetura.app'
STAGING_CLOUD_FRONTEND_URL='https://app-staging.vetura.app'
PRODUCTION_CLOUD_API_URL='https://api.vetura.app'
PRODUCTION_CLOUD_FRONTEND_URL='https://app.vetura.app'

# Support SSH: public key only (private key never goes on the SD card).
# Build fails without this. One fleet key: a leak opens every device.
PUBKEY_SSH_FIRST_USER='ssh-ed25519 AAAA... support@vetura'
PUBKEY_ONLY_SSH=1

# Required by pi-gen; build.sh replaces "change-me" with a random value.
# Not a login password — PasswordAuthentication is disabled.
FIRST_USER_PASS='change-me'

# RSA 2048 private key of IMAGE_ENV, used to sign boot.img (and pieeprom on production).
# Keep it outside the repo and backed up offline; never commit it or copy it into the image.
SECURE_BOOT_KEY='/absolute/path/to/secure-boot-staging.pem'
