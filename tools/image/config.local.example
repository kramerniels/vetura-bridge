# Copy to config.local and fill in. config.local is gitignored.

# Required for QR pairing on first boot
export CLOUD_BASE_URL='https://your-cloud-app.example.com'

# First-user login (required when DISABLE_FIRST_BOOT_USER_RENAME=1)
FIRST_USER_PASS='change-me'
# PUBKEY_SSH_FIRST_USER='ssh-ed25519 AAAA... your@host'
# PUBKEY_ONLY_SSH=1
