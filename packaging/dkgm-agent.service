[Unit]
Description=DKGM agent (LAN portal + NATS worker)
After=network-online.target dkgm-provision.service
Wants=network-online.target
Requires=dkgm-provision.service

[Service]
Type=simple
User=dkgm-agent
Group=dkgm-agent
WorkingDirectory=/opt/dkgm-agent
EnvironmentFile=-/opt/dkgm-agent/.env
# + = run as root even with User=dkgm-agent; syncs helpers, sudoers, and this unit
ExecStartPre=+/opt/dkgm-agent/packaging/sync-helpers.sh
ExecStart=/usr/bin/node /opt/dkgm-agent/src/portal/index.js
Restart=on-failure
RestartSec=5

# Bind to port 80 without running as root.
# No CapabilityBoundingSet: sudo helpers (systemUpdate/systemReboot/update) need
# a full root capability set. AmbientCapabilities still grants port 80 to dkgm-agent.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# NoNewPrivileges and ProtectSystem are intentionally unset so the dkgm-agent user
# can run /usr/local/sbin/dkgm-agent-* helpers via sudoers.
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/dkgm-agent /var/lib/dkgm-agent

# Kill portal and its worker child together
KillMode=control-group

[Install]
WantedBy=multi-user.target
