#!/bin/sh
# Root helper for NATS command systemUpdate. Whitelisted recipes only.
# Install: copy to /usr/local/sbin/, root:root, mode 0755.
set -eu

RECIPE="${1:-}"
APT_OPTS="-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
SUMMARY_MAX=2000

json_escape() {
    printf '%s' "$1" | tr '\n' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

case "$RECIPE" in
    fullUpgrade|distUpgrade) ;;
    *)
        echo "Unknown recipe (allowed: fullUpgrade, distUpgrade): $RECIPE" >&2
        exit 1
        ;;
esac

export DEBIAN_FRONTEND=noninteractive

started=$(date +%s)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

set +e
# shellcheck disable=SC2086
apt-get update $APT_OPTS >"$tmp" 2>&1
update_code=$?
set -e

if [ "$update_code" -ne 0 ]; then
    tail -c "$SUMMARY_MAX" "$tmp" >&2 || true
    echo "apt-get update failed with exit code $update_code" >&2
    exit "$update_code"
fi

set +e
# shellcheck disable=SC2086
case "$RECIPE" in
    fullUpgrade)
        apt-get upgrade -y $APT_OPTS >>"$tmp" 2>&1
        ;;
    distUpgrade)
        apt-get dist-upgrade -y $APT_OPTS >>"$tmp" 2>&1
        ;;
esac
upgrade_code=$?
set -e

if [ "$upgrade_code" -ne 0 ]; then
    tail -c "$SUMMARY_MAX" "$tmp" >&2 || true
    echo "apt-get upgrade/dist-upgrade failed with exit code $upgrade_code" >&2
    exit "$upgrade_code"
fi

duration=$(($(date +%s) - started))
duration_ms=$((duration * 1000))
summary=$(tail -c "$SUMMARY_MAX" "$tmp" 2>/dev/null || true)

if [ -f /var/run/reboot-required ]; then
    reboot_required=true
else
    reboot_required=false
fi

printf '{"recipe":"%s","ok":true,"rebootRequired":%s,"durationMs":%s,"apt":{"updateExitCode":0,"upgradeExitCode":0},"summary":"%s"}\n' \
    "$RECIPE" "$reboot_required" "$duration_ms" "$(json_escape "$summary")"
