[Unit]
Description=Pi API (LAN portal + NATS worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi-api
Group=pi-api
WorkingDirectory=/opt/pi-api
EnvironmentFile=-/opt/pi-api/.env
ExecStart=/usr/bin/node /opt/pi-api/src/portal/index.js
Restart=on-failure
RestartSec=5

# Bind to port 80 without running as root.
# No CapabilityBoundingSet: sudo helpers (systemUpdate/systemReboot) need a full
# root capability set. AmbientCapabilities still grants port 80 to pi-api.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# NoNewPrivileges and ProtectSystem are intentionally unset so the pi-api user
# can run /usr/local/sbin/pi-api-system-{update,reboot} via sudoers.
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/pi-api /var/lib/pi-api

# Kill portal and its worker child together
KillMode=control-group

[Install]
WantedBy=multi-user.target
