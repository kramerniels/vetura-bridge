#!/bin/sh
# Root helper for NATS command update (app OTA).
# Install: synced to /usr/local/sbin/ by deploy/sync-helpers.sh.
# Zip must include node_modules; no npm ci on device.
set -eu

URL="${1:-}"
APP_DIR="/opt/pi-api"
PREV_DIR="/opt/pi-api.previous"
SERVICE_USER="pi-api"
SERVICE_GROUP="pi-api"

json_escape() {
    printf '%s' "$1" | tr '\n' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

fail() {
    echo "$1" >&2
    exit 1
}

restore_previous() {
    if [ -d "${PREV_DIR}" ]; then
        rm -rf "${APP_DIR}"
        mv "${PREV_DIR}" "${APP_DIR}"
    fi
}

case "${URL}" in
    https://*) ;;
    *)
        fail "URL must start with https://"
        ;;
esac

started=$(date +%s)
work=$(mktemp -d /var/tmp/pi-api-update.XXXXXX)
trap 'rm -rf "${work}"' EXIT

preserve="${work}/preserve"
extract_root="${work}/extract"
mkdir -p "${preserve}" "${extract_root}"

curl -fsSL --proto '=https' --tlsv1.2 -o "${work}/package.zip" "${URL}" \
    || fail "Download failed"

unzip -q "${work}/package.zip" -d "${extract_root}" \
    || fail "Unzip failed"

# Resolve content root: single top-level dir with package.json, else extract root
content_root="${extract_root}"
set -- "${extract_root}"/*
if [ "$#" -eq 1 ] && [ -d "$1" ] && [ -f "$1/package.json" ]; then
    content_root="$1"
fi

[ -f "${content_root}/package.json" ] || fail "Missing package.json in zip"
[ -d "${content_root}/node_modules" ] || fail "Missing node_modules in zip (required; no npm ci on device)"

pkg_name=$(node -pe 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).name || ""' "${content_root}/package.json")
[ "${pkg_name}" = "pi-api" ] || fail "package.json name must be pi-api (got: ${pkg_name:-empty})"

version=$(node -pe 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).version || "unknown"' "${content_root}/package.json")

[ -d "${APP_DIR}" ] || fail "Missing ${APP_DIR}"

# Preserve device secrets from the live tree
if [ -f "${APP_DIR}/.env" ]; then
    cp -a "${APP_DIR}/.env" "${preserve}/.env"
fi
if [ -f "${APP_DIR}/credentials.creds" ]; then
    cp -a "${APP_DIR}/credentials.creds" "${preserve}/credentials.creds"
fi

# Clear any leftover previous tree from a prior failed/partial run
rm -rf "${PREV_DIR}"

# Swap: current → previous, new → current
if ! mv "${APP_DIR}" "${PREV_DIR}"; then
    fail "Failed to move ${APP_DIR} aside"
fi

if ! mv "${content_root}" "${APP_DIR}"; then
    restore_previous
    fail "Failed to move new tree into ${APP_DIR}"
fi

# Restore secrets
if [ -f "${preserve}/.env" ]; then
    cp -a "${preserve}/.env" "${APP_DIR}/.env"
fi
if [ -f "${preserve}/credentials.creds" ]; then
    cp -a "${preserve}/credentials.creds" "${APP_DIR}/credentials.creds"
fi

if ! chown -R "${SERVICE_USER}:${SERVICE_GROUP}" "${APP_DIR}"; then
    restore_previous
    fail "chown failed; restored previous tree"
fi

# Ensure deploy scripts are executable
if [ -f "${APP_DIR}/deploy/sync-helpers.sh" ]; then
    chmod 0755 "${APP_DIR}/deploy/sync-helpers.sh" || true
fi
if [ -d "${APP_DIR}/deploy/helpers" ]; then
    chmod 0755 "${APP_DIR}/deploy/helpers/"* 2>/dev/null || true
fi

# Success: drop previous tree to free disk
rm -rf "${PREV_DIR}"

duration_ms=$((($(date +%s) - started) * 1000))

printf '{"ok":true,"version":"%s","restartScheduled":true,"durationMs":%s}\n' \
    "$(json_escape "${version}")" "${duration_ms}"

# Defer restart so the worker can publish results and ack NATS.
( sleep 3; /bin/systemctl restart pi-api ) >/dev/null 2>&1 &
exit 0
