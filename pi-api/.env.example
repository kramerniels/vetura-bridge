# Copy to .env and fill in values. Never commit .env to git.

# Scaleway NATS
NATS_URL=tls://nats.mnq.nl-ams.scaleway.com:4222
NATS_CREDS_FILE=/opt/pi-api/credentials.creds
NATS_STREAM=commands
NATS_SUBJECT=commands.printLabel
NATS_ERROR_SUBJECT=errors.printLabel
NATS_CONSUMER=pi-printer-1
NATS_MAX_AGE_SEC=3600

# Optional overrides
# SCRIPT_TIMEOUT_MS=30000
